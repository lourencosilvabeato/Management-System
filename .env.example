# PostgreSQL connection string — managed by Payload, never manipulate directly
DATABASE_URI=postgres://postgres:<password>@localhost:5432/sistema-niu

# Payload CMS secret — minimum 32 characters, generate with: openssl rand -hex 32
PAYLOAD_SECRET=<generate-a-32-char-secret>

# OpenAI API key — GPT-4o (text + vision) — required for AI estimates
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# Figma Personal Access Token — enables Figma file analysis in AI estimates (optional)
# Get one at: Figma → Settings → Personal Access Tokens
# Required scopes: file:read
FIGMA_API_TOKEN=figd_...

# Cloudflare R2 — file uploads (mockups, attachments)
# Not required in development — files are stored locally in /media
CLOUDFLARE_R2_BUCKET=your-bucket-name
CLOUDFLARE_R2_ACCESS_KEY=your-r2-access-key
CLOUDFLARE_R2_SECRET_KEY=your-r2-secret-key
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Resend — transactional email (optional in prototype)
RESEND_API_KEY=re_...

# Next.js public server URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Anthropic — not used in this project, leave empty
ANTHROPIC_API_KEY=
